NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taman_inventory
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
DB_SSL_CERT_PATH=
DB_SSL_KEY_PATH=
ALLOW_DEMO_PASSWORD_FALLBACK=false
ALLOW_LEGACY_PLAINTEXT_PASSWORD_FALLBACK=false
ALERT_CRON=0 7 * * *
ENABLE_ALERT_CRON=false
ALERT_MAIL_TO=ops@example.com
ENABLE_IDEMPOTENCY_CLEANUP_CRON=true
IDEMPOTENCY_CLEANUP_CRON=0 * * * *
IDEMPOTENCY_TTL_HOURS=24
