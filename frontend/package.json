{
  "name": "taman-inventory-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:stable",
    "dev:fast": "rm -rf .next-dev && next dev -H 127.0.0.1 -p 3000",
    "dev:stable": "rm -rf .next-dev && WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "next": "^15.5.5",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
