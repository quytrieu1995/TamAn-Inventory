{
  "name": "taman-inventory",
  "version": "1.0.0",
  "description": "MVP foundation for multi-plant, multi-warehouse food material and finished-goods management.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx backend/src/scripts/migrate.ts",
    "idempotency:cleanup": "tsx backend/src/scripts/idempotency-cleanup.ts",
    "test": "node --import tsx --test backend/src/tests/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quytrieu1995/TamAn-Inventory.git"
  },
